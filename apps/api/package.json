{
  "name": "@radar/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && func start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "db:types": "kysely-codegen --env-file ../../.env --out-file src/db/types.ts --exclude-pattern schema_migrations --date-parser string --numeric-parser number && biome format --write src/db/types.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
