{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Functions host loads compiled JavaScript from dist/, so this package emits.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"]
}
